{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/builder/**",
              "components/core/**",
              "components/data/**",
              "components/developer/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/overlays/**",
              "ui_kits/builder/**",
              "ui_kits/dashboard/**",
              "ui_kits/developer/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|icon|actions|onDismiss|style|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: tone, title, children, icon, actions, onDismiss, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SecretField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|prefix|revealed|onReveal|canCopy|key|ref|className|style|children)$/]",
        "message": "<SecretField> doesn't accept that prop. Declared props: value, prefix, revealed, onReveal, canCopy."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|shape|tinted|status|icon|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size, shape, tinted, status, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|md|lg|xl)$/]",
        "message": "<Avatar> size must be one of 'xs' | 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:circle|square)$/]",
        "message": "<Avatar> shape must be one of 'circle' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:success|warning|error|neutral)$/]",
        "message": "<Avatar> status must be one of 'success' | 'warning' | 'error' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|variant|size|icon|dot|mono|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, variant, size, icon, dot, mono, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BuilderCanvas'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|toolbar|minimap|zoom|onZoom|onFit|overlay|style|key|ref|className|style|children)$/]",
        "message": "<BuilderCanvas> doesn't accept that prop. Declared props: children, toolbar, minimap, zoom, onZoom, onFit, overlay, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconAfter|loading|disabled|block|href|as|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconAfter, loading, disabled, block, href, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|interactive|selected|as|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, interactive, selected, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|elevated|subtle|flat)$/]",
        "message": "<Card> variant must be one of 'default' | 'elevated' | 'subtle' | 'flat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChartContainer'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|controls|legend|height|children|style|key|ref|className|style|children)$/]",
        "message": "<ChartContainer> doesn't accept that prop. Declared props: title, description, controls, legend, height, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|indeterminate|label|description|invalid|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, indeterminate, label, description, invalid."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|lang|filename|lineNumbers|maxHeight|actions|style|key|ref|className|style|children)$/]",
        "message": "<CodeBlock> doesn't accept that prop. Declared props: code, lang, filename, lineNumbers, maxHeight, actions, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:preset|icon|domain|title|description|action|secondaryAction|inline|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: preset, icon, domain, title, description, action, secondaryAction, inline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|htmlFor|required|optional|hint|error|success|counter|children|className|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, htmlFor, required, optional, hint, error, success, counter, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FileUpload'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|files|onRemove|state|accept|multiple|onPick|icon|key|ref|className|style|children)$/]",
        "message": "<FileUpload> doesn't accept that prop. Declared props: label, hint, files, onRemove, state, accept, multiple, onPick, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='FileUpload'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|active|error)$/]",
        "message": "<FileUpload> state must be one of 'default' | 'active' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:field|operator|value|onRemove|onClick|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: field, operator, value, onRemove, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|summary|selected|invalid|dragging|handles|badge|fields|width|onClick|style|key|ref|className|style|children)$/]",
        "message": "<FlowNode> doesn't accept that prop. Declared props: kind, title, summary, selected, invalid, dragging, handles, badge, fields, width, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|label|style|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, label, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|invalid|valid|mono|icon|iconAfter|prefixText|suffixText|boxedAffix|clearable|onClear|wrapClassName|wrapStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: size, invalid, valid, mono, icon, iconAfter, prefixText, suffixText, boxedAffix, clearable, onClear, wrapClassName, wrapStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogicKeyword'] > JSXAttribute > JSXIdentifier[name!=/^(?:word|key|ref|className|style|children)$/]",
        "message": "<LogicKeyword> doesn't accept that prop. Declared props: word."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogicKeyword'] > JSXAttribute[name.name='word'] > Literal[value!=/^(?:IF|AND|OR|THEN|ELSE)$/]",
        "message": "<LogicKeyword> word must be one of 'IF' | 'AND' | 'OR' | 'THEN' | 'ELSE'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItemSpec'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|shortcut|danger|disabled|checked|onClick|type|key|ref|className|style|children)$/]",
        "message": "<MenuItemSpec> doesn't accept that prop. Declared props: label, icon, shortcut, danger, disabled, checked, onClick, type."
