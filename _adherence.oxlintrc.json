      {
        "selector": "JSXOpeningElement[name.name='MenuItemSpec'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:item|separator|label)$/]",
        "message": "<MenuItemSpec> type must be one of 'item' | 'separator' | 'label'."
